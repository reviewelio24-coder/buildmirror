# mock: 로컬에서 GitHub/Supabase 없이 다중 프로젝트 흐름을 확인합니다.
# supabase: 실제 Auth·Postgres·RLS를 사용합니다. URL과 anon key가 필요합니다.
APP_DATA_MODE=mock

# 공개 값은 브라우저에 노출됩니다. anon key는 RLS와 함께 쓰는 공개 키이며,
# service_role 키를 여기에 넣지 마세요.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

NEXT_PUBLIC_APP_URL=http://localhost:3000

# 앱 런타임과 클라이언트 번들에 사용하지 않습니다.
# 로컬 마이그레이션이나 관리 작업이 필요할 때만 별도 도구에서 사용하세요.
# SUPABASE_SERVICE_ROLE_KEY=
