# mock: 로컬에서 GitHub/Supabase 없이 다중 프로젝트 흐름을 확인합니다.
# supabase: 실제 Auth·Postgres·RLS를 사용합니다. URL과 anon key가 필요합니다.
APP_DATA_MODE=mock

# 공개 값은 브라우저에 노출됩니다. anon key는 RLS와 함께 쓰는 공개 키이며,
# service_role 키를 여기에 넣지 마세요.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

NEXT_PUBLIC_APP_URL=http://localhost:3000

# 브라우저와 일반 앱 store에는 넣지 마세요.
# GitHub webhook 서버 모듈(`src/lib/supabase/webhook-admin.ts`)에서만 사용합니다.
# SUPABASE_SERVICE_ROLE_KEY=

# GitHub App (서버 전용). mock 모드와 CI에서는 비워 둬도 됩니다.
# NEXT_PUBLIC_ 접두사를 붙이지 마세요. private key와 installation token은
# 데이터베이스에 저장하지 않습니다.
# GITHUB_APP_ID=
# GITHUB_APP_CLIENT_ID=
# GITHUB_APP_PRIVATE_KEY=
# GITHUB_APP_SLUG=
# GitHub App client secret. user-to-server token 교환 전용. DB에 저장하지 않습니다.
# GITHUB_APP_CLIENT_SECRET=
# 사용자 승인 callback. 경로는 /api/github/user-callback 이어야 합니다.
# GITHUB_USER_CALLBACK_URL=http://localhost:3000/api/github/user-callback
# 설치·OAuth state HMAC용. 32자 이상. private key/client secret에서 파생하지 않습니다.
# GITHUB_INSTALL_STATE_SECRET=
# Webhook HMAC. 16자 이상. raw body 서명 검증 전용. DB에 저장하지 않습니다.
# 실제 GitHub webhook을 받을 때만 필요합니다. mock 테스트/빌드에는 없어도 됩니다.
# GITHUB_WEBHOOK_SECRET=
